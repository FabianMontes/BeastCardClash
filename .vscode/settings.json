{
    // 1. Automatización basada en Git
    "explorer.excludeGitIgnore": true,
    "search.useIgnoreFiles": true,
    // 2. Limpieza visual específica (lo que sí queremos ver en Git pero no en el editor)
    "files.exclude": {
        "**/*.meta": true,
        "**/*.unityproj": true,
        "**/*.sln": true,
        "**/*.csproj": true
    },
    // 3. Optimización de búsqueda
    "search.exclude": {
        "**/Library/**": true,
        "**/Temp/**": true,
        "**/Logs/**": true,
        "**/*.meta": true
    },
    // 4. Extra: Evita que VS Code intente procesar archivos gigantes de Unity
    "files.watcherExclude": {
        "**/Library/**": true,
        "**/Temp/**": true,
        "**/Logs/**": true
    },
    "files.associations": {
        "*.controller": "yaml",
        "*.anim": "yaml",
        "*.shadergraph": "json",
        "*.inputactions": "json",
        "*.unity": "yaml",
        "*.asset": "yaml"
    },
}